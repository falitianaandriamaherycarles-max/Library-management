pipeline {
    agent any

    tools {
        maven 'Maven_3_8'
        jdk 'Java_17'
    }

    environment {
        REPO_URL = 'https://github.com/your-username/library-management.git'
        GIT_CREDENTIALS = 'github-credentials'
        MAVEN_OPTS = '-Xmx2048m'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.BRANCH_NAME ?: '*/main']],
                    userRemoteConfigs: [[
                        url: env.REPO_URL,
                        credentialsId: env.GIT_CREDENTIALS
                    ]],
                    extensions: [
                        [$class: 'CloneOption', depth: 1],
                        [$class: 'CleanBeforeCheckout']
                    ]
                ])
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Unit Tests') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Integration Tests') {
            steps {
                sh 'mvn verify'
            }
            post {
                always {
                    junit 'target/failsafe-reports/*.xml'
                }
            }
        }

        stage('Regression Tests') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    chmod +x scripts/regression-tests.sh
                    ./scripts/regression-tests.sh
                '''
            }
        }

        stage('Code Coverage') {
            steps {
                sh 'mvn jacoco:report'
            }
            post {
                always {
                    publishHTML([
                        reportDir: 'target/site/jacoco',
                        reportFiles: 'index.html',
                        reportName: 'JaCoCo Coverage Report'
                    ])
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    def coverage = sh(
                        script: "grep -o 'Total.*[0-9]\\+%' target/site/jacoco/index.html | grep -o '[0-9]\\+%' | sed 's/%//' | head -1",
                        returnStdout: true
                    ).trim()

                    def threshold = (env.BRANCH_NAME == 'main') ? 85 : 80
                    if (coverage.toInteger() < threshold) {
                        error "❌ Code coverage ${coverage}% below threshold ${threshold}%"
                    }
                    echo "✅ Code coverage: ${coverage}%"
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'develop'
            }
            steps {
                sh 'chmod +x scripts/deploy.sh && ./scripts/deploy.sh staging'
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Deploy to production?', ok: 'Yes'
                sh 'chmod +x scripts/deploy.sh && ./scripts/deploy.sh production'
            }
        }
    }

    post {
        success {
            emailext (
                to: 'andrymaherytiana@gmail.com',
                subject: "✅ Build #${env.BUILD_NUMBER} succeeded",
                body: "Build succeeded on ${env.BRANCH_NAME}\nURL: ${env.BUILD_URL}"
            )
        }
        failure {
            emailext (
                to: 'andrymaherytiana@gmail.com',
                subject: "❌ Build #${env.BUILD_NUMBER} failed",
                body: "Build failed on ${env.BRANCH_NAME}\nURL: ${env.BUILD_URL}\nLogs: ${env.BUILD_URL}/console"
            )
        }
        always {
            cleanWs()
        }
    }
}